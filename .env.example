# Local development only. Generate BETTER_AUTH_SECRET before starting.
DATABASE_URL=postgresql://guangmo:local-development-only@127.0.0.1:55432/guangmo
REDIS_URL=redis://127.0.0.1:56379
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
API_PORT=3001
# Containers set this to 0.0.0.0; local development remains loopback-only.
API_HOST=127.0.0.1
# Research remains unavailable until BOTH are configured.
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
RESEARCH_MODEL=

# Gmail pilot. Set the pilot address and comma-separated controlled recipients in API and Worker.
# Provide OAuth credentials to the Worker through server-side environment variables.
GMAIL_PILOT_ADDRESS=
GMAIL_PILOT_RECIPIENTS=
GMAIL_PILOT_CLIENT_ID=
GMAIL_PILOT_CLIENT_SECRET=
GMAIL_PILOT_REFRESH_TOKEN=
