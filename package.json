{
  "name": "magic-growth",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test scripts/feishu/workflow.test.mjs",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @guangmo/database db:generate",
    "db:migrate": "pnpm --filter @guangmo/database db:migrate",
    "admin:create": "pnpm --filter @guangmo/api admin:create",
    "env:check": "node scripts/env-check.mjs",
    "worktree:init": "node scripts/worktree-init.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "feishu:intake": "node scripts/feishu-intake.mjs",
    "test:smoke": "pnpm --filter @guangmo/api test:smoke",
    "test:workflow": "pnpm --filter @guangmo/api test:workflow",
    "test:schedules": "pnpm --filter @guangmo/api test:schedules",
    "test:scoring": "pnpm --filter @guangmo/api test:scoring",
    "test:intelligence": "pnpm --filter @guangmo/api test:intelligence",
    "test:products": "pnpm --filter @guangmo/api test:products",
    "test:market-watch": "pnpm --filter @guangmo/api test:market-watch",
    "test:competitor-research": "pnpm --filter @guangmo/api test:competitor-research",
    "test:conversations": "pnpm --filter @guangmo/api test:conversations"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "1.65.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
